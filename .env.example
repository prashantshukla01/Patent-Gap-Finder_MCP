# ─── Phase 1 ───────────────────────────────────────────
# No secrets required for Phase 1 (PDF parsing only)

# ─── Phase 2 (AI / Classification) ────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Phase 3 (Patent Search) ──────────────────────────
USPTO_API_KEY=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
