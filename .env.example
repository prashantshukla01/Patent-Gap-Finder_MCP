# ─── Phase 1 ───────────────────────────────────────────
# No secrets required for Phase 1 (PDF parsing only)

# ─── Phase 2 — Gemini AI ──────────────────────────────
GEMINI_API_KEY=GET_YOUR_OWN_KEY_FROM_GOOGLE_AI_STUDIO

# ─── Phase 2 — Database ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/patent_gap_finder

# ─── Phase 3 — Redis (broker + cache) ─────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Phase 3 — EPO OPS API ────────────────────────────
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# ─── Phase 3 — SerpAPI (Google Patents fallback) ──────
SERPAPI_KEY=

# ─── Phase 3 — USPTO (optional, higher rate limits) ───
USPTO_API_KEY=

# ─── Phase 4 — Qdrant (vector store) ─────────────────
QDRANT_URL=http://localhost:6333

# ─── Phase 4 — White-space tuning (optional) ─────────
WHITESPACE_THRESHOLD=0.65
K_NEAREST_PATENTS=10

# ─── Phase 5 — Security ──────────────────────────────
MCP_API_KEY=your_secret_api_key_here
# If not set, HTTP transport has NO authentication (development only)

# ─── Phase 5 — Rate limiting ─────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ─── Phase 5 — Logging ───────────────────────────────
LOG_LEVEL=INFO    # DEBUG / INFO / WARNING / ERROR

# ─── Server ───────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
