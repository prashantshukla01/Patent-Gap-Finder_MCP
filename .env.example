# ─── Phase 1 ───────────────────────────────────────────
# No secrets required for Phase 1 (PDF parsing only)

# ─── Phase 2 — Gemini AI ──────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Phase 2 — Database ───────────────────────────────
# For local dev: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=password -e POSTGRES_DB=patent_gap_finder postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/patent_gap_finder

# ─── Phase 3 (Patent Search) ──────────────────────────
USPTO_API_KEY=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
SERPAPI_KEY=

# ─── Phase 4+ (Storage) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ─── Server ───────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
