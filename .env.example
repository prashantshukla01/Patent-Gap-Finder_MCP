# ─── Phase 1 ───────────────────────────────────────────
# No secrets required for Phase 1 (PDF parsing only)

# ─── Phase 2 — Gemini AI ──────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=GET_YOUR_OWN_KEY_FROM_GOOGLE_AI_STUDIO

# ─── Phase 2 — Database ───────────────────────────────
# For local dev: docker compose up -d postgres
DATABASE_URL=postgresql+asyncpg://postgres:%40Blackbuck08@localhost:5432/patent_gap_finder

# ─── Phase 3 — Redis (broker + cache) ─────────────────
# For local dev: docker compose up -d redis
REDIS_URL=redis://localhost:6379/0

# ─── Phase 3 — EPO OPS API ────────────────────────────
# Free registration at: https://developers.epo.org
# ~2000 req/day on free tier, 4GB/week data limit
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# ─── Phase 3 — SerpAPI (Google Patents fallback) ──────
# 100 free searches/month at: https://serpapi.com
# Used ONLY when USPTO + EPO return < 30 results
SERPAPI_KEY=

# ─── Phase 3 — USPTO (optional, higher rate limits) ───
# Register free at: https://patentsview.org/apis
USPTO_API_KEY=

# ─── Phase 4+ (Vector Storage) ────────────────────────
QDRANT_URL=http://localhost:6333

# ─── Server ───────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
